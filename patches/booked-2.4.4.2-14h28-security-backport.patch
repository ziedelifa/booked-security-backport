+function booked_validate_and_build_timestamp( $date, $timeslot ) {
+	if ( ! is_string( $date ) || ! is_string( $timeslot ) ) {
+		return false;
+	}
+	$date = trim( $date );
+	$timeslot = trim( $timeslot );
+	if ( ! preg_match( '/^(\d{4})-(\d{1,2})-(\d{1,2})$/', $date, $date_matches ) ) {
+		return false;
+	}
+	$year  = intval( $date_matches[1] );
+	$month = intval( $date_matches[2] );
+	$day   = intval( $date_matches[3] );
+	if ( ! checkdate( $month, $day, $year ) ) {
+		return false;
+	}
+	if ( ! preg_match( '/^(\d{4})-(\d{4})$/', $timeslot, $ts_matches ) ) {
+		return false;
+	}
+	$start_raw = $ts_matches[1];
+	$end_raw   = $ts_matches[2];
+	$start_h   = intval( substr( $start_raw, 0, 2 ) );
+	$start_m   = intval( substr( $start_raw, 2, 2 ) );
+	$end_h     = intval( substr( $end_raw, 0, 2 ) );
+	$end_m     = intval( substr( $end_raw, 2, 2 ) );
+	if ( $start_h > 24 || $start_m > 59 || $end_h > 24 || $end_m > 59 ) {
+		return false;
+	}
+	if ( ( $start_h === 24 && $start_m > 0 ) || ( $end_h === 24 && $end_m > 0 ) ) {
+		return false;
+	}
+	$normalized_date = sprintf( '%04d-%02d-%02d', $year, $month, $day );
+	$time_str = ( $start_raw === '0000' || $start_raw === '2400' )
+		? '00:00:00'
+		: sprintf( '%02d:%02d:00', $start_h, $start_m );
+	$timestamp = strtotime( $normalized_date . ' ' . $time_str );
+	if ( ! $timestamp ) {
+		return false;
+	}
+	return array(
+		'date'      => $normalized_date,
+		'timeslot'  => $timeslot,
+		'timestamp' => $timestamp,
+	);
 }
 
