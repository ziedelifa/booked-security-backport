+function booked_user_can_manage_appointment( $appt_id, $user = null ) {
+	$appt_id = intval( $appt_id );
+	if ( ! $appt_id || get_post_type( $appt_id ) !== 'booked_appointments' ) {
+		return false;
+	}
+	if ( ! $user ) {
+		$user = wp_get_current_user();
+	}
+	if ( empty( $user ) || empty( $user->ID ) ) {
+		return false;
+	}
+	if ( user_can( $user, 'manage_booked_options' ) ) {
+		return true;
+	}
+	if ( ! user_can( $user, 'edit_booked_appointments' ) ) {
+		return false;
+	}
+	$terms = wp_get_post_terms( $appt_id, 'booked_custom_calendars' );
+	if ( empty( $terms ) || is_wp_error( $terms ) ) {
+		return false;
+	}
+	$allowed_ids = booked_get_agent_calendar_ids( $user );
+	foreach ( $terms as $term ) {
+		if ( in_array( intval( $term->term_id ), $allowed_ids, true ) ) {
+			return true;
+		}
+	}
+	return false;
+}
