+function booked_user_can_manage_calendar( $calendar_id = false, $user = null ) {
+	if ( ! $user ) {
+		$user = wp_get_current_user();
+	}
+	if ( empty( $user ) || empty( $user->ID ) ) {
+		return false;
+	}
+	if ( user_can( $user, 'manage_booked_options' ) ) {
+		return true;
+	}
+	if ( ! user_can( $user, 'edit_booked_appointments' ) ) {
+		return false;
+	}
+	if ( is_array( $calendar_id ) ) {
+		$calendar_id = reset( $calendar_id );
+	}
+	$calendar_id = intval( $calendar_id );
+	if ( ! $calendar_id ) {
+		// Booking Agents cannot manage the global Default Calendar
+		return false;
+	}
+	$allowed_ids = booked_get_agent_calendar_ids( $user );
+	return in_array( $calendar_id, $allowed_ids, true );
+}
